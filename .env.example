APP_NAME=Studio
APP_ENV=development
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
PORT=3000
DATABASE_URL=file:storage/database.sqlite
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
# Directory for rendered MP4s. Default: storage/renders
STUDIO_STORAGE=
# ffmpeg (default), hyperframes, or remotion. The last two need those CLIs on PATH.
STUDIO_RENDERER=ffmpeg
